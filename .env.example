# Copy this file to .env and fill in your values

# ── Postgres ───────────────────────────────────────────────
POSTGRES_DB=dpg_asset
POSTGRES_USER=dpg
POSTGRES_PASSWORD=changeme

# ── Backend ────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key

# ── MinIO ──────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Google SSO (optional) ──────────────────────────────────
# OAuth 2.0 Web application Client ID from Google Cloud Console.
# Add your domains (and http://localhost for dev) to the client's
# "Authorized JavaScript origins". Empty disables the Google button.
GOOGLE_CLIENT_ID=
# Restrict Google SSO sign-ups to this email domain, e.g. datphuong.vn
GOOGLE_ALLOWED_DOMAIN=

# ── Seed admin (one-shot: docker compose exec backend python -m app.scripts.seed_admin) ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
